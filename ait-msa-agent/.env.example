# --- LLM (Groq)
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_MAX_TOKENS=400
LLM_REQUEST_TIMEOUT=15
# Precio USD por millón de tokens (supuesto: ajustar a la tarifa vigente del modelo en Groq)
LLM_PRICE_INPUT_PER_MILLION=0.29
LLM_PRICE_OUTPUT_PER_MILLION=0.59

# --- Límites del agente
MAX_STEPS=8
# Tokens por consulta: total (input + output) y topes separados por tipo
MAX_TOKENS_BUDGET=10000
MAX_INPUT_TOKENS_BUDGET=8000
MAX_OUTPUT_TOKENS_BUDGET=2000
GLOBAL_TIMEOUT_SECONDS=45
# Presupuesto por sesión (~3 consultas complejas de 10.000 tokens)
SESSION_TOKEN_BUDGET=30000
# Circuit breaker: 2 = una llamada idéntica repetida abre el circuito
LOOP_THRESHOLD=2
MAX_CONSECUTIVE_TOOL_ERRORS=3

# --- Herramientas y persistencia
TOOL_DELAY_SECONDS=2
SQLITE_PATH=data/analysis.db

# --- CORS (en Cloud Run agrega la URL del frontend)
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$|^https://ait-msa-frontend-.*\.run\.app$

# --- Observabilidad (LangSmith). En false no sale ninguna traza de la máquina.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ait-msa-agent
